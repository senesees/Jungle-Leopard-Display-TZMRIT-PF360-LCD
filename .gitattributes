# Normalise to LF in the repository; check out native. Keeps diffs clean without
# forcing anyone's editor to change behaviour.
* text=auto

# Windows-native tooling that is happiest with CRLF on disk.
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.manifest  text eol=crlf

# Never touch these.
*.png binary
*.ico binary
*.jpg binary
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
