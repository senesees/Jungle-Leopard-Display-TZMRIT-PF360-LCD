<Application x:Class="JLDisplayManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JLDisplayManager.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <v:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True"/>

            <!-- A dark palette throughout: this window sits next to a lit panel,
                 and a bright chrome around a preview of it reads badly. -->
            <Color x:Key="BgColor">#16130F</Color>
            <SolidColorBrush x:Key="Bg"        Color="#16130F"/>
            <SolidColorBrush x:Key="BgRaised"  Color="#1F1B16"/>
            <SolidColorBrush x:Key="BgSunken"  Color="#100D0A"/>
            <SolidColorBrush x:Key="Line"      Color="#332C24"/>
            <SolidColorBrush x:Key="Text"      Color="#EFE7DC"/>
            <SolidColorBrush x:Key="TextDim"   Color="#9B8F80"/>
            <SolidColorBrush x:Key="Accent"    Color="#F0A030"/>
            <SolidColorBrush x:Key="AccentDim" Color="#7A5620"/>
            <SolidColorBrush x:Key="Danger"    Color="#E2603C"/>

            <!-- Buttons -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BgRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A241C"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#0E0B08"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BgSunken}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            </Style>

            <!-- The ComboBox keeps its system-drawn light chrome, so its text
                 has to be dark. That fights the implicit TextBlock style above,
                 which wins over inherited Foreground inside a control template
                 and would otherwise paint near-white text on a white popup. The
                 items set their colour explicitly for the same reason. -->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
