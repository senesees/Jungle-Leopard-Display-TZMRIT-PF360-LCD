<Application x:Class="JLDisplayManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JLDisplayManager.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <v:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True"/>

            <!-- A dark palette throughout: this window sits next to a lit panel,
                 and a bright chrome around a preview of it reads badly. -->
            <Color x:Key="BgColor">#16130F</Color>
            <SolidColorBrush x:Key="Bg"        Color="#16130F"/>
            <SolidColorBrush x:Key="BgRaised"  Color="#1F1B16"/>
            <SolidColorBrush x:Key="BgSunken"  Color="#100D0A"/>
            <SolidColorBrush x:Key="Line"      Color="#332C24"/>
            <SolidColorBrush x:Key="Text"      Color="#EFE7DC"/>
            <SolidColorBrush x:Key="TextDim"   Color="#9B8F80"/>
            <SolidColorBrush x:Key="Accent"    Color="#F0A030"/>
            <SolidColorBrush x:Key="AccentDim" Color="#7A5620"/>
            <SolidColorBrush x:Key="Danger"    Color="#E2603C"/>

            <!-- Menus: the shell draws a context menu light-on-light, which
                 next to this palette looks like a different application's. It
                 is templated here rather than left to the system, the same way
                 the buttons are. -->
            <Style x:Key="Menu" TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource BgRaised}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="3">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuRow" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="row" Background="Transparent" CornerRadius="3">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="#2A241C"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuLine" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="8,4"
                                    Background="{StaticResource Line}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buttons -->
            <Style x:Key="Btn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BgRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A241C"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#0E0B08"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A borderless glyph button for actions that belong to one row of
                 a list, where a full bordered button would out-weigh the row it
                 sits in. Turns red on hover: every use of it so far destroys
                 something. -->
            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="3"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#3A211A"/>
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BgSunken}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            </Style>

            <!-- A tooltip's content string is rendered through a generated
                 TextBlock, which picks up the implicit style above and comes out
                 near-white — on the system's near-white tooltip chrome, which is
                 invisible. Setting Foreground on the ToolTip does not help: that
                 explicit setter beats the inherited value, the same trap the
                 ComboBox has below.

                 So the whole thing is templated dark, and the TextBlock style
                 inside the template names its colour rather than inheriting one,
                 which is what actually makes it stick. -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource BgRaised}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,5"/>
                <!-- The default drop shadow is drawn by the system chrome this
                     template replaces, and leaves a grey halo without it. -->
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Text}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxWidth" Value="320"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The ComboBox keeps its system-drawn light chrome, so its text
                 has to be dark. That fights the implicit TextBlock style above,
                 which wins over inherited Foreground inside a control template
                 and would otherwise paint near-white text on a white popup. The
                 items set their colour explicitly for the same reason. -->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#1A1207"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="6,4"/>
            </Style>

            <!-- For a ComboBox filled from an ItemsSource of strings. Each item
                 is rendered through a generated TextBlock, which picks up the
                 implicit TextBlock style above — near-white, on the popup's
                 system-drawn light background, which is unreadable. The
                 ComboBoxItem Foreground does not save it: an explicit setter on
                 the TextBlock beats an inherited value.

                 The hand-written ComboBoxItems elsewhere set their colour inline
                 for the same reason; this is that fix for items that have no
                 markup to put it in. -->
            <DataTemplate x:Key="ComboText">
                <TextBlock Text="{Binding}" Foreground="#1A1207"/>
            </DataTemplate>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
