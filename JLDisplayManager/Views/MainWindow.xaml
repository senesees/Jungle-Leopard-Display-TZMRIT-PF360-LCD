<Window x:Class="JLDisplayManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jungle Leopard Display"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        Background="{StaticResource Bg}"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Library tile -->
        <DataTemplate x:Key="LibraryTile">
            <Border Width="168" Margin="0,0,10,10" CornerRadius="6"
                    Background="{StaticResource BgRaised}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <Border Height="84" CornerRadius="5,5,0,0" Background="{StaticResource BgSunken}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                            <!-- Marks a video without needing a second column of
                                 text; the tile is too small for a label. -->
                            <Border Background="#B0000000" CornerRadius="3"
                                    Padding="5,1" Margin="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding IsVideo,
                                        Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="VIDEO" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"/>
                            </Border>

                            <!-- Marks what the pipeline made, so a generated
                                 image is never mistaken for one you added. -->
                            <Border Background="#B0000000" CornerRadius="3"
                                    Padding="5,1" Margin="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding IsGenerated,
                                        Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="AI" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"/>
                            </Border>

                            <!-- A pinned image survives retention pruning. -->
                            <Border Background="#B0000000" CornerRadius="3"
                                    Padding="5,1" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding Pinned,
                                        Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="PINNED" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Name}" Margin="8,6,8,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>

                    <TextBlock Margin="8,2,8,6" FontSize="10"
                               Foreground="{StaticResource TextDim}"
                               Text="{Binding Kind}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Playlist row -->
        <DataTemplate x:Key="PlaylistRow">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4"
                    Background="{StaticResource BgRaised}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="26" CornerRadius="3"
                            Background="{StaticResource BgSunken}" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dwell only means something for a still; a video ends
                             when it ends. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsVideo,
                                        Converter={StaticResource BoolToVisibilityInverse}}">
                            <TextBox Text="{Binding DwellSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Width="38" FontSize="11" Padding="4,2"
                                     TextAlignment="Center"
                                     ToolTip="Seconds to show this image before moving on"/>
                            <TextBlock Text="s" Margin="3,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Text="video" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}"
                                   Visibility="{Binding IsVideo,
                                       Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="388"/>
        </Grid.ColumnDefinitions>

        <!-- ============ status bar ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Padding="12,9"
                CornerRadius="6" Background="{StaticResource BgRaised}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9"
                             VerticalAlignment="Center" Margin="0,0,9,0" Fill="{StaticResource Danger}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Starting…" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDetail" FontSize="11"
                                   Foreground="{StaticResource TextDim}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="AI" Style="{StaticResource Btn}" Click="OnAi"
                                Margin="0,0,8,0"
                                ToolTip="Generate images automatically and put them on the panel"/>
                        <Button Content="Settings" Style="{StaticResource Btn}" Click="OnSettings"/>
                    </StackPanel>
                </Grid>

                <!-- The AI line. Collapsed until the pipeline has done
                     something, so the bar stays as it was for anyone not using
                     it. Generation is slow and mostly invisible, so what stage
                     it is at is the single most useful thing to show. -->
                <Border x:Name="AiBar" Grid.Row="1" Margin="0,9,0,0" Padding="10,7"
                        CornerRadius="4" Background="{StaticResource BgSunken}"
                        BorderBrush="{StaticResource AccentDim}" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="AiDot" Grid.Column="0" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,9,0"
                                 Fill="{StaticResource AccentDim}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AiStatusText" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AiPromptText" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextDim}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Button x:Name="AiToggleButton" Grid.Column="2" Content="Stop AI"
                                Style="{StaticResource Btn}" Padding="10,4" FontSize="11"
                                Click="OnToggleAi"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ library ============ -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Padding="12"
                CornerRadius="6" Background="#1A1712"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- Two sources, one grid. Generated images arrive on their
                         own schedule and in bulk, so mixing them into the
                         hand-picked library buries it. -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LibraryTab" Content="LIBRARY"
                                Style="{StaticResource BtnPrimary}" Padding="12,5" FontSize="11"
                                Click="OnShowLibrary"/>
                        <Button x:Name="GeneratedTab" Content="GENERATED"
                                Style="{StaticResource Btn}" Margin="6,0,0,0"
                                Padding="12,5" FontSize="11"
                                Click="OnShowGenerated"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddFilesButton" Content="Add files…"
                                Style="{StaticResource Btn}" Click="OnAddFiles"/>
                        <Button x:Name="DownloadButton" Content="Download…"
                                Style="{StaticResource Btn}" Margin="0,0,8,0"
                                Click="OnDownload"
                                ToolTip="Fetch a YouTube video and add it to the library"/>
                        <Button x:Name="OpenGeneratedButton" Content="Open folder"
                                Style="{StaticResource Btn}" Click="OnOpenGeneratedFolder"
                                Visibility="Collapsed"
                                ToolTip="Show the generated images on disk"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="LibraryList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource LibraryTile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Extended"
                         IsSynchronizedWithCurrentItem="False"
                         MouseDoubleClick="OnLibraryDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="sel" CornerRadius="7" Padding="2"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="sel" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource TextDim}"
                           Text="Drop images and videos here,&#x0a;or use Add files."/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Show now" Style="{StaticResource BtnPrimary}" Click="OnShowNow"/>
                    <Button Content="Add to playlist" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="OnAddToPlaylist"/>
                    <Button Content="Remove" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="OnRemoveFromLibrary"/>
                    <Button x:Name="PinButton" Content="Pin" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="OnTogglePin" Visibility="Collapsed"
                            ToolTip="Keep this image when older ones are cleared out"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ right column ============ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- now playing -->
            <Border Grid.Row="0" Padding="12" Margin="0,0,0,12" CornerRadius="6"
                    Background="#1A1712" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ON THE PANEL" Style="{StaticResource Heading}"/>

                    <!-- Fixed 2:1, matching the panel, so the preview is a true
                         picture of the glass rather than a letterboxed guess. -->
                    <Viewbox Stretch="Uniform">
                        <Border Width="960" Height="480" CornerRadius="4"
                                Background="Black" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Fill"/>
                                <TextBlock x:Name="PreviewPlaceholder"
                                           Text="nothing on screen"
                                           FontSize="34" Foreground="#3A332A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Viewbox>

                    <TextBlock x:Name="PlaybackStats" Margin="0,8,0,0" FontSize="11"
                               Foreground="{StaticResource TextDim}"/>

                    <!-- What was asked for, when the panel is showing something
                         the pipeline made. -->
                    <TextBlock x:Name="PanelPromptText" Margin="0,6,0,0" FontSize="11"
                               Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" MaxHeight="48"
                               Visibility="Collapsed"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Margin="10,0"
                                Minimum="0" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="OnBrightnessChanged"/>
                        <TextBlock x:Name="BrightnessValue" Grid.Column="2" Width="34"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Stop" Style="{StaticResource Btn}" Click="OnStop"/>
                        <Button x:Name="ReconnectButton" Content="Reconnect" Style="{StaticResource Btn}"
                                Margin="8,0,0,0" Click="OnReconnect"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- playlist -->
            <Border Grid.Row="1" Padding="12" CornerRadius="6"
                    Background="#1A1712" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="PlaylistHeading" Text="PLAYLIST"
                                   Style="{StaticResource Heading}" Margin="0"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="ShuffleBox" Content="Shuffle" HorizontalAlignment="Right"
                                  Margin="0" Click="OnShuffleChanged"/>
                    </Grid>

                    <ListBox x:Name="PlaylistList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemTemplate="{StaticResource PlaylistRow}"
                             IsSynchronizedWithCurrentItem="False"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="sel" CornerRadius="5"
                                                    BorderThickness="2" BorderBrush="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="sel" Property="BorderBrush"
                                                            Value="{StaticResource AccentDim}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Grid.Row="1" x:Name="PlaylistEmptyHint"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{StaticResource TextDim}"
                               Text="Pick items on the left and&#x0a;choose Add to playlist."/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlaylistButton" Content="Play playlist"
                                    Style="{StaticResource BtnPrimary}" Click="OnTogglePlaylist"/>
                            <Button Content="◀" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Padding="10,6" Click="OnPrevious" ToolTip="Previous item"/>
                            <Button Content="▶" Style="{StaticResource Btn}" Margin="4,0,0,0"
                                    Padding="10,6" Click="OnNext" ToolTip="Next item"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Up" Style="{StaticResource Btn}" Click="OnMoveUp"/>
                            <Button Content="Down" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                    Click="OnMoveDown"/>
                            <Button Content="Remove" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                    Click="OnRemoveFromPlaylist"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
