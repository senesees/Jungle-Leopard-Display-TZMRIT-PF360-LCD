<Window x:Class="JLDisplayManager.Views.YoutubeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download from YouTube" Height="340" Width="520"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Closing="OnClosing">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="YouTube URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Grid.Row="1" Height="28"
                 ToolTip="A single video link. Playlists are not downloaded."/>

        <TextBlock x:Name="HintText" Grid.Row="2" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDim}" Margin="0,10,0,0"/>

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,10,0,0"
                    Visibility="Collapsed">
            <!-- Indeterminate until yt-dlp reports a percentage: the stages
                 before the first byte arrives take a few seconds on their own,
                 and a bar sitting at zero reads as a hang. -->
            <ProgressBar x:Name="ProgressBar" Height="6" IsIndeterminate="True"
                         Background="{StaticResource BgSunken}"
                         Foreground="{StaticResource Accent}"
                         BorderBrush="{StaticResource Line}" BorderThickness="1"/>
            <TextBlock x:Name="ProgressText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextDim}" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="DownloadButton" Content="Download"
                    Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                    Click="OnDownload"
                    ToolTip="Fetch the video and add it to the library"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Btn}"
                    Click="OnCancel" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
